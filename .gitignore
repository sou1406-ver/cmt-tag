# Research payloads stay local: raw, imports, labels, reservations, models.
/data/
/outputs/*
!/outputs/README.md
# Local blind-test source lists/receipts; never publish candidate URLs or evidence.
/test_posts.csv
/test_posts.xlsx
/test_posts_draft.csv
/review_source_inventory.csv
/crawl/*.csv
# Retain protection for legacy local media; no media is present in this clone.
/media/
.venv/
.venv-*/
data/local_models/
__pycache__/
*.py[cod]
*.npz
*.npy
*.pkl
*.model
*.joblib
*.safetensors
*.pt
*.pth
*.onnx
.pytest_cache/

# Local secrets; keep example templates eligible for version control.
.env
.env.*
!.env.example
!.env.sample
/.playwright-browsers/

# New research exports must not enter public Git, including outside data/outputs.
*.xlsx
*.xls
*.xlsm
*.csv
!configs/*.example.csv
!tests/fixtures/*.csv
*.jsonl
!tests/fixtures/*.jsonl
*.parquet
*.zip
*.7z
/docs/annotation_reviews/
**/node_modules/
**/cookies.json
**/cookies.txt
**/storage_state.json
**/browser_profile*/

# User-provided prompt embeds real comments; local only.
/docs/annotation/AI_LABEL_PROMPT.md
