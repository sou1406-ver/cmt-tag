{
  "schema_version": "1.0",
  "inputs": [
    {
      "path": "tests/fixtures/comments.csv",
      "format": "csv",
      "source_dataset": "fixture_csv",
      "post_namespace": "fixture_platform",
      "columns": {"text_raw": "body", "comment_id": "cid", "post_id": "pid"}
    },
    {
      "path": "tests/fixtures/comments.json",
      "format": "json",
      "source_dataset": "fixture_json",
      "post_namespace": "fixture_platform",
      "columns": {"text_raw": "body", "comment_id": "cid", "post_id": "pid"}
    }
  ],
  "quality": {"ui_strings": ["Thích", "Phản hồi"], "spam_patterns": []},
  "near_duplicate": {"threshold": 0.9, "min_chars": 40, "shingle_size": 3},
  "split": {"seed": 42, "ratios": {"train": 0.6, "dev": 0.2, "test": 0.2}}
}
